url = {https://www.semanticscholar.org/paper/faa00c594f72110f05f0070e13145d7dddbdfbc8},
abstract = {S2 TL;DR: A novel feature encoding based on partial similarities of tokens, its extension to part-of-speech tags (HoPSTags) and question type information and sentence embeddings based features are proposed to improve the grading performance.},
author = {Swarnadeep Saha and Tejas I. Dhamecha and S. Marvaniya and Renuka Sindhgatta and Bikram Sengupta},
doi = {10.1007/978-3-319-93843-1_37},
